rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // CMS data is publicly readable and writable so every visitor and all devices see real-time updates from admin
    match /cms/{docId} {
      allow read, write: if true;
    }

    // Individual products and categories
    match /products/{productId} {
      allow read, write: if true;
    }

    match /categories/{catId} {
      allow read, write: if true;
    }

    // Customer and Admin accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Real-time quick inquiries & sales agent live chat
    match /chatInquiries/{inquiryId} {
      allow read, write: if true;
    }
    match /chatInquiries/{inquiryId}/messages/{messageId} {
      allow read, write: if true;
    }
    match /quickInquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Commercial RFQs & Quote Requests: real-time synchronisation across all devices
    match /rfqRequests/{rfqId} {
      allow read, write: if true;
    }

    match /rfqs/{rfqId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

